{
  "dns": {
    "servers": [
      // Resolver
      { "tag": "dbs-pod-udp", "type": "udp", "server": "119.29.29.29" },
      { "tag": "dns-aliyun-udp-1", "type": "udp", "server": "223.5.5.5" },
      { "tag": "dns-aliyun-udp-2", "type": "udp", "server": "223.6.6.6" },
      { "tag": "dns-resolver", "type": "group", "servers": ["dbs-pod-udp", "dns-aliyun-udp-1", "dns-aliyun-udp-2"] },
      // Direct
      { "tag": "dns-aliyun", "type": "h3", "server": "dns.alidns.com", "domain_resolver": "dns-resolver" },
      { "tag": "dns-pod", "type": "https", "server": "doh.pub", "domain_resolver": "dns-resolver" },
      { "tag": "dns-direct", "type": "group", "servers": ["dns-pod", "dns-aliyun"] },
      // Proxy
      { "tag": "dns-one", "type": "h3", "server": "one.one.one.one", "detour": "🔰 默认出口" },
      { "tag": "dns-cloudflare", "type": "h3", "server": "cloudflare-dns.com", "detour": "🔰 默认出口" },
      { "tag": "dns-proxy", "type": "group", "servers": ["dns-one", "dns-cloudflare"] },
      // Hosts
      { "tag": "dns-hosts", "type": "hosts", "path": ["config/hosts", "/etc/hosts"] },
      // Local
      { "tag": "dns-local", "type": "local", "neighbor_domain": [".lan", ".home.arpa"] },
      // FakeIP
      { "tag": "dns-fakeip", "type": "fakeip", "inet4_range": "28.0.0.0/8" }
    ],
    "rules": [
      // Hosts
      { "rule_set": "LocalDomain", "action": "predefined", "rcode": "NXDOMAIN" },
      { "preferred_by": "dns-hosts", "server": "dns-hosts" },
      // Local
      { "preferred_by": "dns-local", "server": "dns-local", "rewrite_ttl": 3600 },
      { "rule_set": "Lan", "action": "predefined", "rcode": "NXDOMAIN" },
      // Public
      { "rule_set": "PublicDNS", "server": "dns-resolver" },
      // Clash
      { "clash_mode": "Direct", "server": "dns-direct" },
      { "clash_mode": "Global", "server": "dns-fakeip" },
      // Direct
      { "action": "evaluate", "server": "dns-direct" },
      { "rule_set": ["FakeIpBypass", "GeoSites@CN"], "action": "respond" },
      { "match_response": true, "rule_set": "GeoIP@CN", "action": "respond" },
      // FakeIP
      { "query_type": ["A", "AAAA"], "server": "dns-fakeip", "rewrite_ttl": 1 }
    ],
    "final": "dns-proxy",
    "reverse_mapping": true,
    "strategy": "prefer_ipv6"
  },
  "route": {
    "rules": [
      {
        "source_ip_cidr": ["127.0.0.0/8", "::1/128", "192.168.50.1/32"],
        "inbound": ["dns-in", "redirect-in", "tproxy-in", "tun-in"],
        "action": "reject"
      },
      { "inbound": "dns-in", "action": "hijack-dns" },
      { "network": "icmp", "outbound": "DIRECT" },
      { "ip_is_private": true, "outbound": "DIRECT" },
      { "action": "sniff" },
      { "protocol": "dns", "action": "hijack-dns" },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          { "rule_set": ["GeoIP@CN", "GeoSites@CN"], "invert": true },
          {
            "type": "logical",
            "mode": "or",
            "rules": [
              { "network": "tcp", "port": 853 },
              { "protocol": ["http", "tls"], "rule_set": "DoH" }
            ]
          }
        ],
        "action": "reject"
      },
      {
        "type": "logical",
        "mode": "and",
        "rules": [
          { "rule_set": ["GeoIP@CN", "GeoSites@CN"], "invert": true },
          {
            "type": "logical",
            "mode": "or",
            "rules": [
              { "network": "udp", "port": 853 },
              { "protocol": "quic", "rule_set": "DoH" }
            ]
          }
        ],
        "action": "reject",
        "method": "drop"
      },
      { "protocol": ["bittorrent", "ntp", "stun"], "outbound": "DIRECT" },
      {
        "rule_set": ["FakeIpBypass", "Private", "Direct", "GeoIP@CN", "GeoSites@CN"],
        "invert": true,
        "action": "sniff-override-destination"
      }
    ],
    "default_domain_resolver": "dns-direct",
    "default_mark": "0x7890",
    "dhcp_lease_files": "/var/lib/misc/dnsmasq.leases"
  }
}
// vim: ft=jsonc
